{% extends "./layout.njk" %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/radios/macro.njk" import govukRadios %}
{%- from "moj/components/alert/macro.njk" import mojAlert -%}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% set pageTitle = 'Check your answers' %}
{% set formButtonText = "Confirm" %}

{% block formContent %}

{% if errorList | length %}
  {{ govukErrorSummary({
    attributes: {
      "data-testid": "error-summary"
    },
    titleText: "There is a problem",
    errorList: errorList
  }) }}
{% endif %}

{% if warningMessages | length %}
  {% set warningHtml %}
    <ul class="govuk-list govuk-list--bullet">
      {% for message in warningMessages %}
        <li>{{ message }}</li>
      {% endfor %}
    </ul>
    <p class="govuk-body">Check your answers below and change them if needed.</p>
  {% endset %}

  {{ mojAlert({
    variant: 'warning',
    title: 'Check before you confirm',
    showTitleAsHeading: true,
    dismissible: false,
    html: warningHtml,
    attributes: {
      "data-testid": "warning-alert"
    }
  }) }}
{% endif %}

<h2 class="govuk-heading-l">
  {{ pageTitle }}
</h2>

{% from template import form with context %}

<div class="govuk-!-display-none">
  {{ form() }}
</div>

{{ govukSummaryList({
  rows: rows
}) }}

{% if showWillAlertPractitionerMessage %}
  {{ mojAlert({
    variant: 'information',
    title: 'This outcome will result in alert',
    dismissible: false,
    html: 'This outcome will be shared with the practitioner as it requires enforcement action.'
  }) }}
{% endif %}

{% if alertPractitionerItems | length %}
  {{ govukRadios({
    name: "alertPractitioner",
    fieldset: {
      legend: {
        text: alertDiaryText,
        classes: "govuk-fieldset__legend--m"
      }
    },
    hint: {
      text: "This will send the alert for information whether or not there is an enforcement"
    },
    items: alertPractitionerItems,
    errorMessage: errors.alertPractitioner
  }) }}
{% endif %}

{% endblock %}
