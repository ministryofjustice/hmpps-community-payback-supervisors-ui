{% extends "./layout.njk" %}

{% from "govuk/components/input/macro.njk" import govukInput %}

{% set pageTitle = documentTitle %}

{% block formContent %}

  {% macro form() %}
    <input type="hidden" name="deliusVersion" value="{{ deliusVersion }}"/>

    {{ govukInput({
      label: {
        text: question,
        classes: "govuk-label--l"
      },
      id: "time",
      name: "time",
      type: "time",
      value: time,
      errorMessage: errors.time
    }) }}
  {% endmacro %}

  {{ form() }}

{% endblock %}
